// Prisma Schema for Smart HR Employee Management System
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   // "SUPER_ADMIN", "VIEWER"
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id                   String    @id @default(uuid())
  employeeNo           String    @unique // Employee No
  employeeId           String?   // Optional alias
  fullName             String    // Employee Full Name
  callingName          String?   // Calling name
  gender               String?   // Gender (Male, Female, Other)
  birthDate            String?   // Birthdate
  civilStatus          String?   // Civil Status (Single, Married, Divorced, Widowed)
  nicNumber            String?   // NIC Number (SENSITIVE: Restricted from VIEWER)

  // Organization & Employment
  division             String?   // Division
  designation          String?   // Designation
  basedShift           String    @default("Day") // Based Shift: Day / Night / General
  shiftTimings         String?   // Shift Timings e.g. "08:00 AM - 05:00 PM"
  joiningDate          String?   // Joining date
  resignedDate         String?   // Resigned date
  employmentStatus     String    @default("Probation") // Permanent / Probation
  status               String    @default("Active") // Active / Resigned / Inactive

  // Contact Details
  email                String?   // Email
  contactNumber        String?   // Contact number
  residentAddress      String?   // Resident Address
  permanentAddress     String?   // Permanent Address

  // Emergency Contact
  emergencyContact     String?   // Emergency contact
  relationship         String?   // Relationship

  // Compensation (SENSITIVE: Restricted from VIEWER)
  salary               Float?    // Salary

  // Backward compatibility fields
  firstName            String?
  middleName           String?
  lastName             String?
  company              String?   @default("akoma")
  branch               String?
  department           String?
  reportsTo            String?
  grade                String?
  employmentType       String?   @default("Full-time")
  shiftType            String?   @default("Day")
  isStaff              Boolean?  @default(true)
  mobile               String?
  companyEmail         String?
  personalEmail        String?
  currentAddress       String?
  currentAddressIs     String?
  permanentAddressIs   String?
  emergencyContactName String?
  emergencyPhone       String?
  emergencyRelation    String?
  leaveBalance         Int?      @default(14)
  attendancePercentage Float?    @default(98.5)
  basicSalary          Float?
  allowances           Float?
  deductions           Float?
  netSalary            Float?
  bankName             String?
  bankAccountNumber    String?
  paymentMethod        String?
  maritalStatus        String?
  bloodGroup           String?
  nationality          String?
  nationalId           String?
  bio                  String?
  avatarUrl            String?
  confirmationDate     String?
  contractEndDate      String?
  relievingDate        String?
  exitReason           String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SystemSetting {
  id                      String    @id @default("system_config")
  maintenanceMode         Boolean   @default(false)
  maintenanceNotice       String    @default("System is currently undergoing routine maintenance.")
  allowViewerRegistration Boolean   @default(false)
  systemVersion           String    @default("v1.0.0")
  superAdminSecretCode    String    @default("HR7788")
  lastBackupAt            DateTime?
  updatedAt               DateTime  @updatedAt
}

model SystemLog {
  id          String   @id @default(uuid())
  action      String
  performedBy String
  details     String?
  level       String   @default("INFO") // INFO, WARN, ERROR
  createdAt   DateTime @default(now())
}
